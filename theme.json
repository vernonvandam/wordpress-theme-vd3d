{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "760px", "wideSize": "1200px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        { "slug": "green", "name": "VD3D Green", "color": "#78C874" },
        { "slug": "green-strong", "name": "Green strong", "color": "#399738" },
        { "slug": "green-ink", "name": "Green ink", "color": "#267625" },
        { "slug": "on-green", "name": "Text on green", "color": "#090F09" },
        { "slug": "industrial", "name": "Industrial", "color": "#0F100F" },
        { "slug": "industrial-deep", "name": "Industrial deep", "color": "#070707" },
        { "slug": "industrial-text", "name": "Industrial text", "color": "#F8F8F8" },
        { "slug": "industrial-muted", "name": "Industrial muted", "color": "#9D9F9D" },
        { "slug": "industrial-border", "name": "Industrial border", "color": "#2A2C2A" },
        { "slug": "ink", "name": "Ink", "color": "#191B19" },
        { "slug": "muted", "name": "Muted text", "color": "#606460" },
        { "slug": "background", "name": "Background", "color": "#FBFCFB" },
        { "slug": "surface", "name": "Surface", "color": "#EFF1EF" },
        { "slug": "border", "name": "Border", "color": "#D6D8D6" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Space Grotesk",
          "fontFamily": "\"Space Grotesk\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Space Grotesk",
              "fontWeight": "300 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/space-grotesk.woff2"]
            }
          ]
        },
        {
          "slug": "body",
          "name": "DM Sans",
          "fontFamily": "\"DM Sans\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontWeight": "100 1000",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/dm-sans.woff2"]
            },
            {
              "fontFamily": "DM Sans",
              "fontWeight": "100 1000",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/dm-sans-italic.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "eyebrow", "name": "Eyebrow", "size": "11px" },
        { "slug": "small", "name": "Small", "size": "12px" },
        { "slug": "body", "name": "Body", "size": "14px" },
        { "slug": "lead", "name": "Lead", "size": "16px" },
        { "slug": "card-title", "name": "Card title", "size": "20px" },
        { "slug": "title", "name": "Callout title", "size": "24px" },
        { "slug": "section", "name": "Section heading", "size": "clamp(30px, 4vw, 44px)" },
        { "slug": "page-title", "name": "Page title", "size": "clamp(32px, 4.6vw, 46px)" },
        { "slug": "display", "name": "Display", "size": "clamp(44px, 7vw, 76px)" }
      ]
    },
    "spacing": {
      "units": ["px", "%", "rem", "vw"],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "8px" },
        { "slug": "20", "name": "S", "size": "16px" },
        { "slug": "30", "name": "M", "size": "24px" },
        { "slug": "40", "name": "L", "size": "40px" },
        { "slug": "50", "name": "XL", "size": "64px" },
        { "slug": "60", "name": "XXL", "size": "96px" }
      ]
    },
    "border": { "radius": true, "color": true, "width": true, "style": true }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--background)", "text": "var(--wp--preset--color--ink)" },
    "spacing": {
      "padding": { "left": "clamp(16px, 4vw, 48px)", "right": "clamp(16px, 4vw, 48px)" },
      "blockGap": "24px"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.8"
    },
    "elements": {
      "heading": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "500", "lineHeight": "1.15" },
        "color": { "text": "var(--wp--preset--color--ink)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--page-title)", "lineHeight": "1.1" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--section)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--card-title)", "fontWeight": "600", "lineHeight": "1.3" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--lead)", "fontWeight": "600", "lineHeight": "1.4" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--green-ink)" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var(--wp--preset--color--ink)" } }
      },
      "button": {
        "color": { "background": "var(--wp--preset--color--green)", "text": "var(--wp--preset--color--on-green)" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--body)", "fontWeight": "600", "lineHeight": "1.2" },
        "border": { "radius": "4px", "width": "0" },
        "spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "22px", "right": "22px" } },
        ":hover": { "color": { "background": "#8FD38C", "text": "var(--wp--preset--color--on-green)" } },
        ":focus": { "outline": { "color": "var(--wp--preset--color--green-ink)", "offset": "2px", "style": "solid", "width": "2px" } }
      },
      "caption": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" }, "color": { "text": "var(--wp--preset--color--muted)" } }
    },
    "blocks": {
      "core/post-title": { "typography": { "fontWeight": "500" } },
      "core/separator": { "color": { "text": "var(--wp--preset--color--border)" } },
      "woocommerce/product-price": { "typography": { "fontWeight": "600" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-no-title", "title": "Page without title", "postTypes": ["page"] }
  ]
}
